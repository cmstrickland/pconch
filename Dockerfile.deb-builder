FROM debian:trixie

# Install debian build dependencies and available Common Lisp libraries
RUN apt-get update && apt-get install -y \
    debhelper \
    sbcl \
    cl-asdf \
    cl-quicklisp \
    gcc \
    devscripts \
    build-essential \
    fakeroot \
    cl-hunchentoot \
    cl-who \
    cl-ppcre \
    cl-bordeaux-threads \
    && rm -rf /var/lib/apt/lists/*

# Initialize quicklisp for packages not in Debian
RUN sbcl --non-interactive \
    --load /usr/share/common-lisp/source/quicklisp/quicklisp.lisp \
    --eval '(quicklisp-quickstart:install :path "/usr/local/quicklisp")' \
    --eval '(quit)'

ENV HOME=/root
RUN echo '(load "/usr/local/quicklisp/setup.lisp")' > /root/.sbclrc

WORKDIR /build

# Copy source files
COPY . /build/

# Make pconch discoverable to ASDF via quicklisp local-projects
RUN mkdir -p /usr/local/quicklisp/local-projects && \
    ln -s /build /usr/local/quicklisp/local-projects/pconch

# Build the .deb package
RUN make clean && make deb

# The .deb file will be in the parent directory after build
CMD ["bash", "-c", "cp ../*.deb /output/ 2>/dev/null || echo 'Build complete. .deb files should be in parent directory'"]
